{
  "name": "EvidenceFile",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID do pedido vinculado"
    },
    "acceptance_id": {
      "type": "string",
      "description": "ID do aceite vinculado, se aplic\u00e1vel"
    },
    "type": {
      "type": "string",
      "enum": [
        "pedido",
        "fabricacao",
        "entrega",
        "descarga",
        "armazenamento",
        "instalacao",
        "assinatura",
        "outro"
      ],
      "description": "Tipo de evid\u00eancia"
    },
    "file_uri": {
      "type": "string",
      "description": "URI do arquivo privado (acesso via URL tempor\u00e1ria assinada)"
    },
    "uploaded_by": {
      "type": "string",
      "description": "ID do usu\u00e1rio que enviou"
    },
    "public_url": {
      "type": "string",
      "description": "URL p\u00fablica legada (apenas arquivos enviados antes da refatora\u00e7\u00e3o)"
    }
  },
  "required": [
    "order_id",
    "type",
    "file_uri"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}