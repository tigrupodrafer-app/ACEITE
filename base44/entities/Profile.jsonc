{
  "name": "Profile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio nativo Base44 vinculado"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio"
    },
    "phone": {
      "type": "string",
      "description": "Telefone/WhatsApp (com DDD)"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "gerente",
        "vendedor",
        "producao",
        "entrega",
        "instalacao",
        "auditoria"
      ],
      "default": "vendedor",
      "description": "Papel/fun\u00e7\u00e3o no sistema"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Perfil ativo"
    },
    "store_id": {
      "type": "string",
      "description": "Loja vinculada, se aplic\u00e1vel"
    }
  },
  "required": [
    "user_id",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}