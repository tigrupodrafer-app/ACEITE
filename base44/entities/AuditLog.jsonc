{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que executou a a\u00e7\u00e3o (ou 'sistema'/'cliente_publico')"
    },
    "order_id": {
      "type": "string",
      "description": "ID do pedido relacionado, se aplic\u00e1vel"
    },
    "action": {
      "type": "string",
      "description": "A\u00e7\u00e3o executada (ex: PEDIDO_CRIADO, ACEITE_N1_REALIZADO)"
    },
    "entity": {
      "type": "string",
      "description": "Entidade afetada (ex: Order, Acceptance)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "old_value": {
      "type": "string",
      "description": "Valor anterior (serializado)"
    },
    "new_value": {
      "type": "string",
      "description": "Novo valor (serializado)"
    },
    "ip": {
      "type": "string",
      "description": "IP da requisi\u00e7\u00e3o"
    },
    "device": {
      "type": "string",
      "description": "User-Agent da requisi\u00e7\u00e3o"
    }
  },
  "required": [
    "action",
    "entity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}