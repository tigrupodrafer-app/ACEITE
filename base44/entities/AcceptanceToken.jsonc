{
  "name": "AcceptanceToken",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID do pedido vinculado"
    },
    "acceptance_id": {
      "type": "string",
      "description": "ID do aceite vinculado (Acceptance), se dispon\u00edvel"
    },
    "token_hash": {
      "type": "string",
      "description": "Hash SHA-256 do token \u2014 o token puro nunca \u00e9 armazenado"
    },
    "level": {
      "type": "number",
      "description": "N\u00edvel do aceite autorizado: 1=Pedido, 2=Entrega, 3=Instala\u00e7\u00e3o"
    },
    "expires_at": {
      "type": "string",
      "description": "Data/hora de expira\u00e7\u00e3o"
    },
    "used_at": {
      "type": "string",
      "description": "Data/hora em que foi utilizado"
    },
    "revoked_at": {
      "type": "string",
      "description": "Data/hora de revoga\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Token ativo"
    }
  },
  "required": [
    "order_id",
    "token_hash",
    "level"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}